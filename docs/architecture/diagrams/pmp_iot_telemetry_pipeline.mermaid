graph LR
    subgraph Edge_Devices ["Patient Wearable Medical Devices"]
        ECG["ECG Smart Patch<br/>(Bluetooth / BLE)"]
        PulseOx["SpO2 Pulse Oximeter<br/>(Continuous Vitals)"]
        BP["Smart BP Monitor<br/>(Cellular / WiFi)"]
    end

    subgraph IoT_Ingestion ["AWS IoT Core Ingestion Tier"]
        IoTCore["AWS IoT Core Broker<br/>(MQTT over TLS 1.3 - Port 8883)<br/>Mutual TLS with X.509 Device Certs"]
        TopicRule["IoT Topic Rules Engine<br/>Topic: healthcare/patients/+/vitals"]
    end

    subgraph Urgent_Alert_Path ["Critical Vitals Emergency Pathway (< 500ms)"]
        SNS_Alert["Amazon SNS: Urgent Vitals Topic"]
        SQS_DLQ["Amazon SQS: Emergency DLQ"]
        Lambda_Triage["AWS Lambda: Clinical Triage Engine"]
        Doctor_App["Physician Mobile Push & Pager"]
        Hospital_Screen["Intensive Care Unit (ICU) Dashboard"]
    end

    subgraph Streaming_Pipeline ["Continuous Ingestion & Telemetry Processing"]
        Kinesis["Amazon Kinesis Data Streams<br/>(Shard Auto-Scaling, 24h Buffer)"]
        Firehose["Amazon Kinesis Data Firehose<br/>(Snappy Compression / Parquet Format)"]
        ECS_Workers["ECS Fargate Consumer Cluster<br/>(Stream Aggregation & Anomaly Models)"]
    end

    subgraph Multi_Tier_Storage ["Tiered Healthcare Persistence Tier"]
        DynamoDB["Amazon DynamoDB<br/>(Hot Telemetry - TTL 30 Days)<br/>Single-Digit ms Latency"]
        Timestream["Amazon Timestream<br/>(Time-Series ECG Waveforms)"]
        S3_Lake["Amazon S3 Medical Data Lake<br/>(SSE-KMS, Glacier Flexible Deep Archive)"]
    end

    subgraph Clinical_Presentation ["Clinical Consumer Applications"]
        PMP_Web["PMP Real-Time Ward Console<br/>(React WebSockets / ALB)"]
        Athena["Amazon Athena & QuickSight<br/>(Population Health Predictive Analytics)"]
    end

    %% Flow connections
    ECG & PulseOx & BP -->|MQTT Publish| IoTCore
    IoTCore --> TopicRule

    %% Rule evaluation
    TopicRule -->|Condition: SpO2 < 90% OR HR > 140| SNS_Alert
    TopicRule -->|Continuous Batch Stream| Kinesis

    %% Urgent path execution
    SNS_Alert --> SQS_DLQ
    SQS_DLQ --> Lambda_Triage
    Lambda_Triage --> Doctor_App & Hospital_Screen
    Lambda_Triage -->|Log Emergency Event| DynamoDB

    %% Streaming & worker execution
    Kinesis --> ECS_Workers
    Kinesis --> Firehose
    ECS_Workers --> DynamoDB
    ECS_Workers --> Timestream
    Firehose --> S3_Lake

    %% Read models
    DynamoDB & Timestream --> PMP_Web
    S3_Lake --> Athena
