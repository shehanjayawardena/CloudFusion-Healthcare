graph TD
    subgraph OnPrem_Branches ["CloudFusion On-Premises & 22 Branch Hospitals"]
        HQ["Central Hospital HQ<br/>(Legacy Data Centre)"]
        Clinic_A["Regional Hospital A<br/>(Outpatient & Inpatient Wards)"]
        Clinic_B["Branch Clinic B<br/>(Diagnostic Lab)"]
        
        subgraph Greengrass_Edge ["Hospital Edge Computing Tier"]
            GG_Core["AWS IoT Greengrass v2 Core<br/>(Industrial Medical Gateway)"]
            Local_Filter["Local Python Telemetry Processor<br/>(Bandwidth Optimization & Filter)"]
            Local_DB["Encrypted SQLite Local Buffer<br/>(Offline Store-and-Forward)"]
            Local_Sensors["Ward Monitors & Wearables"]
        end

        OnPrem_DNS["On-Premises Microsoft Active Directory / DNS<br/>(*.hospital.internal)"]
    end

    subgraph Hybrid_Interconnect ["Enterprise Hybrid Interconnect Layer"]
        DX["AWS Direct Connect (10 Gbps Dedicated Fiber)<br/>Primary Deterministic Low-Latency Link"]
        DXGW["Direct Connect Gateway"]
        VPN["AWS Site-to-Site Dual IPsec VPN<br/>Encrypted Backup Failover Link"]
        TGW["AWS Transit Gateway (Central Routing Hub)<br/>Inter-VPC & Hybrid Traffic Management"]
    end

    subgraph AWS_Cloud_Core ["AWS Cloud Environment (ap-southeast-1)"]
        subgraph Route53_Hybrid_DNS ["Amazon Route 53 Hybrid DNS Resolver"]
            Inbound_Resolver["Route 53 Inbound Resolver Endpoint<br/>(Answers On-Prem queries for *.cloudfusion.internal)"]
            Outbound_Resolver["Route 53 Outbound Resolver Endpoint<br/>(Forwards *.hospital.internal to On-Prem DNS)"]
        end

        subgraph Core_VPC ["Production Healthcare VPC (10.50.0.0/16)"]
            TGW_Attachment["Transit Gateway VPC Attachment"]
            ECS_Cluster["ECS Fargate Core Microservices"]
            Aurora_Cluster["Amazon Aurora Healthcare Database"]
        end

        subgraph Cloud_IoT ["AWS IoT Cloud Services"]
            IoTCore["AWS IoT Core"]
            IoT_DeviceShadow["IoT Device Shadow & Fleet Provisioning"]
        end
    end

    %% Edge flow
    Local_Sensors --> GG_Core
    GG_Core --> Local_Filter
    Local_Filter <--> Local_DB
    Local_Filter -->|Normalized Edge Stream| IoTCore

    %% Hybrid Connectivity
    HQ & Clinic_A & Clinic_B --> DX
    HQ & Clinic_A & Clinic_B -.->|BGP Failover| VPN
    DX --> DXGW
    DXGW --> TGW
    VPN --> TGW
    TGW --> TGW_Attachment
    TGW_Attachment --> ECS_Cluster & Aurora_Cluster

    %% DNS Flow
    OnPrem_DNS <-->|Resolve Cloud Domains| Inbound_Resolver
    ECS_Cluster <-->|Resolve On-Prem Domains| Outbound_Resolver
    Outbound_Resolver <--> OnPrem_DNS

    %% IoT sync
    GG_Core <-->|Device State Sync / Over-The-Air Updates| IoT_DeviceShadow
